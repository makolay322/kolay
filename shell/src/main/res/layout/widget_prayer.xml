<?xml version="1.0" encoding="utf-8"?>
<!-- Flat on purpose: one solid card, two text sizes, no icons or gradients. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:paddingStart="16dp" android:paddingEnd="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" android:maxLines="1"/>
        <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/widget_muted" android:textSize="13sp" android:maxLines="1"/>
        <TextView android:id="@+id/hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/widget_muted" android:textSize="13sp" android:maxLines="1" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_ink" android:textSize="34sp" android:textStyle="bold" android:maxLines="1"/>
</LinearLayout>
