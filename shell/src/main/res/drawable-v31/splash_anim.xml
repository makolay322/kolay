<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash (~2.2 s): the K slides in, the O springs open, the dot pops last. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="288dp" android:height="288dp" android:viewportWidth="768" android:viewportHeight="768">
            <group android:scaleX="0.87" android:scaleY="0.87" android:pivotX="384" android:pivotY="384">
                <group android:name="k" android:translateX="-70">
                    <path android:name="kpath" android:fillColor="@color/logo_splash" android:fillAlpha="0" android:pathData="M168,222H248V328L355,222H470L310,383L470,545H355L248,440V545H168Z"/>
                </group>
                <group android:name="dot" android:pivotX="353" android:pivotY="284" android:scaleX="0" android:scaleY="0">
                    <path android:fillColor="@color/window_bg" android:pathData="M341,284a12,12 0 1,0 24,0a12,12 0 1,0 -24,0Z"/>
                </group>
                <group android:name="o" android:pivotX="497" android:pivotY="388" android:scaleX="0" android:scaleY="0">
                    <path android:fillColor="@color/logo_splash" android:fillType="evenOdd" android:pathData="M395,388a102,102 0 1,0 204,0a102,102 0 1,0 -204,0Z M454,388a43,43 0 1,0 86,0a43,43 0 1,0 -86,0Z"/>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="k">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:valueFrom="-70" android:valueTo="0" android:duration="1100"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="kpath">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:duration="800"/>
        </aapt:attr>
    </target>
    <target android:name="o">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:startOffset="500" android:duration="1100"
                    android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="500" android:duration="1100"
                    android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:startOffset="1350" android:duration="750"
                    android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="1350" android:duration="750"
                    android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
