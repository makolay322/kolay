<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kolay" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- animated "Ko" mark on the system splash screen -->
        <item name="android:windowSplashScreenBackground">@color/window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">2200</item>
    </style>
</resources>
